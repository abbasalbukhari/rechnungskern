# Comma separated API keys accepted in the X-API-Key header. Empty = auth disabled (dev only!)
API_KEYS=dev-key-change-me

# Allowed browser origins for CORS ("*" = any)
CORS_ORIGINS=*

# Logo limits
MAX_LOGO_BYTES=2097152
ALLOW_LOGO_URL=true
LOGO_FETCH_TIMEOUT=5

# Mustang validator (enables POST /v1/validate). Already set inside the Docker image.
MUSTANG_JAR=/opt/mustang/Mustang-CLI.jar
JAVA_BIN=java

# Serve the example browser client at http://localhost:8000/client/
SERVE_CLIENT=true

# Name written into the PDF metadata (Creator)
PDF_PRODUCER=e-rechnung service

# Public browser pages (/rechnung, /pruefung) call key-less endpoints under /v1/public, limited per IP and hour
PUBLIC_ENABLED=true
PUBLIC_RATE_LIMIT=60
PUBLIC_VALIDATE_LIMIT=30

# Website / Impressum / Datenschutz (shown on the public pages; empty = visible placeholder)
SITE_NAME=Rechnungskern
SITE_URL=https://rechnungskern.de
# Alias hosts: website pages redirect (301) to SITE_URL, API/docs stay reachable but get noindex
CANONICAL_REDIRECT_HOSTS=www.rechnungskern.de, api.rechnungskern.de
CONTACT_EMAIL=
OPERATOR_NAME=
OPERATOR_STREET=
OPERATOR_CITY=
OPERATOR_COUNTRY=Deutschland
OPERATOR_PHONE=
OPERATOR_VAT_ID=
OPERATOR_REGISTER=
HOSTING_PROVIDER=IONOS SE, Elgendorfer Str. 57, 56410 Montabaur, Deutschland

# "About" page / author reference (portfolio). Empty values are hidden.
AUTHOR_NAME=
AUTHOR_TITLE_DE=
AUTHOR_TITLE_EN=
AUTHOR_LINKEDIN=
AUTHOR_GITHUB=
AUTHOR_XING=
AUTHOR_WEBSITE=
PROJECT_REPO=https://github.com/abbasalbukhari/rechnungskern
PROJECT_LICENSE=MIT
